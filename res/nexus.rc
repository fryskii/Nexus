#include <windows.h>

1 ICON "nexus.ico"
1 RT_MANIFEST "nexus.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,9,0,0
PRODUCTVERSION 0,9,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "NEXUS Project"
      VALUE "FileDescription", "NEXUS Task Manager"
      VALUE "FileVersion", "0.9.0.0"
      VALUE "InternalName", "NEXUS"
      VALUE "LegalCopyright", "Copyright (C) 2026 NEXUS contributors. MIT License."
      VALUE "OriginalFilename", "NEXUS.exe"
      VALUE "ProductName", "NEXUS"
      VALUE "ProductVersion", "0.9.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

